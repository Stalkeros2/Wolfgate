<controls:WFInteractionWindow
    xmlns="https://spacestation14.io"
    xmlns:controls="clr-namespace:Content.Client._WF.Intimacy.UI"
    xmlns:graphics="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
    Title="{Loc wf-intimacy-window-title}"
    MinSize="460 380">

    <BoxContainer Orientation="Vertical" Margin="8" SeparationOverride="6" HorizontalExpand="True" VerticalExpand="True">
        <Label Name="TargetLabel" Access="Public" StyleClasses="LabelHeading" Text=""/>
        <Label Name="StatusLabel" Access="Public" FontColorOverride="#FFB36B" Text="" Visible="False"/>

        <BoxContainer Orientation="Vertical" SeparationOverride="4" HorizontalExpand="True">
            <Label Name="StatsHeading" Access="Public" StyleClasses="LabelHeading" Text="{Loc wf-intimacy-stats-heading}"/>

            <BoxContainer Orientation="Vertical" SeparationOverride="2" HorizontalExpand="True">
                <Label Name="StatsYouHeading" Access="Public" StyleClasses="LabelSecondary" Text="{Loc wf-intimacy-stats-you}"/>
                <BoxContainer Orientation="Horizontal" SeparationOverride="4" HorizontalExpand="True">
                    <Label Name="StatsYouArousalLabel" Access="Public" Text="{Loc wf-intimacy-bar-arousal}" VerticalAlignment="Center" MinSize="72 0"/>
                    <ProgressBar Name="StatsYouArousalBar" Access="Public" Minimum="0" Maximum="100" HorizontalExpand="True"/>
                    <Label Name="StatsYouArousalValue" Access="Public" Text="0" MinSize="32 0" VerticalAlignment="Center"/>
                </BoxContainer>
                <BoxContainer Orientation="Horizontal" SeparationOverride="4" HorizontalExpand="True">
                    <Label Name="StatsYouPleasureLabel" Access="Public" Text="{Loc wf-intimacy-bar-pleasure}" VerticalAlignment="Center" MinSize="72 0"/>
                    <ProgressBar Name="StatsYouPleasureBar" Access="Public" Minimum="0" Maximum="100" HorizontalExpand="True"/>
                    <Label Name="StatsYouPleasureValue" Access="Public" Text="0" MinSize="32 0" VerticalAlignment="Center"/>
                </BoxContainer>
                <BoxContainer Orientation="Horizontal" SeparationOverride="4" HorizontalExpand="True">
                    <Label Name="StatsYouWetnessLabel" Access="Public" Text="{Loc wf-intimacy-bar-wetness}" VerticalAlignment="Center" MinSize="72 0"/>
                    <ProgressBar Name="StatsYouWetnessBar" Access="Public" Minimum="0" Maximum="100" HorizontalExpand="True"/>
                    <Label Name="StatsYouWetnessValue" Access="Public" Text="0" MinSize="32 0" VerticalAlignment="Center"/>
                </BoxContainer>
            </BoxContainer>

            <BoxContainer Orientation="Vertical" SeparationOverride="2" HorizontalExpand="True">
                <Label Name="StatsTargetHeading" Access="Public" StyleClasses="LabelSecondary" Text="{Loc wf-intimacy-stats-target}"/>
                <BoxContainer Orientation="Horizontal" SeparationOverride="4" HorizontalExpand="True">
                    <Label Name="StatsTargetArousalLabel" Access="Public" Text="{Loc wf-intimacy-bar-arousal}" VerticalAlignment="Center" MinSize="72 0"/>
                    <ProgressBar Name="StatsTargetArousalBar" Access="Public" Minimum="0" Maximum="100" HorizontalExpand="True"/>
                    <Label Name="StatsTargetArousalValue" Access="Public" Text="0" MinSize="32 0" VerticalAlignment="Center"/>
                </BoxContainer>
                <BoxContainer Orientation="Horizontal" SeparationOverride="4" HorizontalExpand="True">
                    <Label Name="StatsTargetPleasureLabel" Access="Public" Text="{Loc wf-intimacy-bar-pleasure}" VerticalAlignment="Center" MinSize="72 0"/>
                    <ProgressBar Name="StatsTargetPleasureBar" Access="Public" Minimum="0" Maximum="100" HorizontalExpand="True"/>
                    <Label Name="StatsTargetPleasureValue" Access="Public" Text="0" MinSize="32 0" VerticalAlignment="Center"/>
                </BoxContainer>
                <BoxContainer Orientation="Horizontal" SeparationOverride="4" HorizontalExpand="True">
                    <Label Name="StatsTargetWetnessLabel" Access="Public" Text="{Loc wf-intimacy-bar-wetness}" VerticalAlignment="Center" MinSize="72 0"/>
                    <ProgressBar Name="StatsTargetWetnessBar" Access="Public" Minimum="0" Maximum="100" HorizontalExpand="True"/>
                    <Label Name="StatsTargetWetnessValue" Access="Public" Text="0" MinSize="32 0" VerticalAlignment="Center"/>
                </BoxContainer>
            </BoxContainer>
        </BoxContainer>

        <BoxContainer Orientation="Horizontal" SeparationOverride="6" HorizontalExpand="True">
            <Label Text="{Loc wf-intimacy-window-intensity}" VerticalAlignment="Center"/>
            <OptionButton Name="IntensityButton" Access="Public" HorizontalExpand="True"/>
        </BoxContainer>

        <BoxContainer Orientation="Horizontal" SeparationOverride="6" HorizontalExpand="True">
            <Label Text="{Loc wf-intimacy-window-speed}" VerticalAlignment="Center"/>
            <OptionButton Name="SpeedButton" Access="Public" HorizontalExpand="True"/>
        </BoxContainer>

        <PanelContainer VerticalExpand="True" HorizontalExpand="True">
            <PanelContainer.PanelOverride>
                <graphics:StyleBoxFlat BackgroundColor="#0B131F" BorderColor="#1E3450" BorderThickness="1"/>
            </PanelContainer.PanelOverride>

            <ScrollContainer VerticalExpand="True" HorizontalExpand="True" Margin="4">
                <BoxContainer Name="ActList" Access="Public" Orientation="Vertical" SeparationOverride="3" HorizontalExpand="True"/>
            </ScrollContainer>
        </PanelContainer>

        <BoxContainer Orientation="Horizontal" SeparationOverride="6" HorizontalExpand="True">
            <Button Name="RefreshButton" Access="Public" Text="{Loc wf-intimacy-window-refresh}"/>
            <Button Name="StopButton" Access="Public" Text="{Loc wf-intimacy-window-stop}" Visible="False" HorizontalExpand="True" HorizontalAlignment="Right"/>
        </BoxContainer>
    </BoxContainer>
</controls:WFInteractionWindow>